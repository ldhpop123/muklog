# Muklog 앱 설정. 이 파일을 복사해 app/.env 로 만들고 값을 채운 뒤:
#   flutter run --dart-define-from-file=.env
#   scripts/build-web.sh        (웹 배포 빌드. API_BASE_URL·USE_MOCK은 스크립트가 덮어씀)
# app/.env 는 .gitignore 에 포함되어 커밋되지 않는다. 여기 값은 모두 앱에 들어가도 되는 공개 값이다.

# true면 서버 없이 목 데이터로 동작
USE_MOCK=true

# 서버 주소
#   로컬 개발: http://localhost:8010 (Android 에뮬레이터·USB 기기는 adb reverse tcp:8010 tcp:8010)
#   배포:      https://api.muklog.app
API_BASE_URL=http://localhost:8010

# 네이버 클라우드 플랫폼 Maps Client ID. 비우면 임시 지도로 동작
# 콘솔에 Android 패키지명·iOS Bundle ID(com.muklog.muklog)와 웹 서비스 URL을 등록해야 한다
NAVER_MAP_CLIENT_ID=

# (웹 전용, 선택) Style Editor에서 장소 라벨을 끈 스타일의 My Style ID
NAVER_MAP_STYLE_ID=

# ── 소셜 로그인 (Secret은 server/.env에) ──
# 카카오 developers.kakao.com > 내 애플리케이션 > 앱 키
KAKAO_NATIVE_APP_KEY=
KAKAO_JS_APP_KEY=
# 구글 Cloud Console > 사용자 인증 정보 > OAuth 클라이언트 ID
# 웹 클라이언트 ID는 웹 로그인과, Android·iOS가 받는 ID 토큰의 대상으로 함께 쓴다
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# 네이버 로그인은 앱에 넣을 값이 없다 (서버가 대신 처리)
