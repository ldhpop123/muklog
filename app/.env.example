# 먹로그 앱 설정. 이 파일을 복사해 app/.env 로 만들고 값을 채운 뒤:
#   flutter run --dart-define-from-file=.env
#   flutter build web --dart-define-from-file=.env
# app/.env 는 .gitignore 에 포함되어 커밋되지 않는다.

# 네이버 클라우드 플랫폼 Maps Client ID. 비우면 임시 지도로 동작
NAVER_MAP_CLIENT_ID=

# (웹 전용, 선택) Style Editor에서 장소 라벨을 끈 스타일의 My Style ID
NAVER_MAP_STYLE_ID=

# true면 서버 없이 목 데이터로 동작
USE_MOCK=true

# 서버 주소. Android 에뮬레이터에서 내 Mac의 서버는 http://10.0.2.2:8010
API_BASE_URL=http://localhost:8010

# ── 소셜 로그인 (앱에 넣어도 되는 공개 값만. Secret은 server/.env에) ──
# 카카오 developers.kakao.com > 내 애플리케이션 > 앱 키
KAKAO_NATIVE_APP_KEY=
KAKAO_JS_APP_KEY=
# 구글 Cloud Console > 사용자 인증 정보 > OAuth 클라이언트 ID
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# 네이버는 앱에 넣을 값이 없다 (서버가 로그인을 대신 처리)
