# 이 파일을 .env로 복사해서 값을 채운다. .env는 git에 올라가지 않는다.

# NAVER API HUB 지역 검색 (NCP 콘솔 > Application Services > NAVER API HUB > Application 등록)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# LLM: off | ollama | claude
MUKLOG_LLM=off

# NCP Maps Reverse Geocoding (앱 지도와 같은 Maps 애플리케이션). 주변 검색어 보정·행정동 브리핑
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# 소셜 로그인
KAKAO_APP_ID=                 # 카카오 개발자 콘솔 > 앱 > 앱 ID(숫자)
NAVER_LOGIN_CLIENT_ID=        # developers.naver.com "네이버 로그인" (검색 API 키와 다름)
NAVER_LOGIN_CLIENT_SECRET=
GOOGLE_CLIENT_IDS=            # 웹·Android·iOS OAuth 클라이언트 ID, 쉼표로 구분

# 네이버 웹 로그인: 이 서버 주소(콜백 = {MUKLOG_PUBLIC_URL}/auth/naver/callback)와 돌아갈 앱 주소 허용 목록
MUKLOG_PUBLIC_URL=
MUKLOG_LOGIN_REDIRECTS=

# 개발용: 1이면 Authorization 헤더 없는 요청을 시드 사용자 "me"로 처리 / 새 사용자가 시드 친구 자동 팔로우
MUKLOG_DEV_AUTH=0
MUKLOG_DEMO=0

# SQLite 저장 위치(기본 server/data/muklog.db). 비우면 저장하지 않고 메모리로만 동작
# MUKLOG_DB=
