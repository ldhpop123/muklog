# 이 파일을 .env로 복사해서 값을 채운다. .env는 git에 올라가지 않는다.
# 빈 값은 설정하지 않은 것과 같다 (기본값을 쓴다).

# ── 배포 주소 ──
# 이 서버의 외부 주소. 네이버 로그인 콜백은 {MUKLOG_PUBLIC_URL}/auth/naver/callback (기본 http://localhost:8010)
#   배포: https://api.muklog.app
MUKLOG_PUBLIC_URL=
# 네이버 로그인 뒤 돌아갈 앱 주소 허용 목록, 쉼표 구분 (scheme·host·port가 정확히 같아야 함)
#   기본: http://localhost:8765,http://127.0.0.1:8765,muklog://auth
#   배포: https://muklog.app,muklog://auth
MUKLOG_LOGIN_REDIRECTS=
# API를 호출할 수 있는 웹 주소, 쉼표 구분. localhost·127.0.0.1은 항상 허용
#   배포: https://muklog.app
MUKLOG_CORS_ORIGINS=

# ── 소셜 로그인 ──
KAKAO_APP_ID=                 # 카카오 개발자 콘솔 > 앱 > 앱 ID(숫자)
NAVER_LOGIN_CLIENT_ID=        # developers.naver.com "네이버 로그인" (검색 API 키와 다름)
NAVER_LOGIN_CLIENT_SECRET=
GOOGLE_CLIENT_IDS=            # 웹·Android·iOS OAuth 클라이언트 ID, 쉼표로 구분

# ── 네이버 API ──
# NAVER API HUB 지역 검색 (NCP 콘솔 > Application Services > NAVER API HUB > Application 등록)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# NCP Maps Reverse Geocoding (앱 지도와 같은 Maps 애플리케이션). 주변 검색어 보정·행정동 브리핑
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# ── LLM (속성 추출·지역 브리핑) ──
# off | ollama | claude. 꺼져 있거나 실패하면 키워드 규칙·문장 템플릿으로 동작
MUKLOG_LLM=off
# 모델 이름 (기본: 제공자별 기본 모델)
# MUKLOG_LLM_MODEL=
# ollama 주소 (기본 http://localhost:11434)
# OLLAMA_URL=
# claude를 쓰면 Anthropic SDK 기본 방식으로 인증한다 (ANTHROPIC_API_KEY 등)
# ANTHROPIC_API_KEY=

# ── 저장 위치 ──
# SQLite 파일 (기본 server/data/muklog.db). 비우면 저장하지 않고 메모리로만 동작
# MUKLOG_DB=
# 업로드한 사진 폴더 (기본 server/uploads)
# MUKLOG_UPLOAD_DIR=

# ── 개발용 ──
# MUKLOG_DEV_AUTH=1: Authorization 헤더 없는 요청을 시드 사용자 "me"로 처리 (배포에서는 0)
# MUKLOG_DEMO=1: 모든 사용자를 서로 친구로 만든다 (시연용)
MUKLOG_DEV_AUTH=0
MUKLOG_DEMO=0
